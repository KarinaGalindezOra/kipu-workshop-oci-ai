# Copy into a private .env. Never commit populated configuration.
OCI_REGION=us-chicago-1
OCI_COMPARTMENT_ID=<approved_project_compartment>
OCI_CONFIG_PROFILE=<individual_approved_profile>
OCI_EMBEDDING_MODEL_ID=cohere.embed-v4.0
OCI_CHAT_MODEL_ID=xai.grok-4.7
LAB02_PARTICIPANT_ID=<assigned_participant_id>
ADB_USERNAME=<assigned_KHIPU_L2_Pnnn_schema>
ADB_CONNECT_STRING=<private_connect_string>
ADB_WALLET_DIR=<private_wallet_directory>
LAB02_VECTOR_DIMENSION=1536
LAB02_CONTRACT_TABLE=LAB02_CONTRACT_CHUNKS
LAB02_TOP_K=3
# Obtain from development calibration; never guess a production threshold.
LAB02_CALIBRATION_FILE=<private_calibration_json>
# true only if the selected model supports configurable output dimensions.
LAB02_SET_OUTPUT_DIMENSIONS=false
