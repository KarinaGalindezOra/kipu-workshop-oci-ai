variable "region" {
  description = "OCI home region selected when the disposable trial was created."
  type        = string
  default     = "us-chicago-1"
}

variable "tenancy_ocid" {
  description = "Trial tenancy OCID supplied at runtime, never committed."
  type        = string
  sensitive   = true
}

variable "team_code" {
  description = "Stable workshop team identifier, for example T01."
  type        = string

  validation {
    condition     = can(regex("^T[0-9]{2}$", upper(var.team_code)))
    error_message = "team_code must use the form T01 through T99."
  }
}

variable "environment" {
  description = "Disposable environment label used in resource names and tags."
  type        = string
  default     = "dev"
}

variable "project_name" {
  description = "Lowercase OCI resource-name prefix."
  type        = string
  default     = "khipu-ai-workshop"

  validation {
    condition     = can(regex("^[a-z][a-z0-9-]{2,29}$", var.project_name))
    error_message = "project_name must start with a lowercase letter and contain only lowercase letters, digits, and hyphens."
  }
}

variable "create_workshop_compartment" {
  description = "Create a dedicated team compartment. Disable only when an approved existing compartment is supplied."
  type        = bool
  default     = true
}

variable "parent_compartment_id" {
  description = "Approved parent compartment or tenancy root OCID for a new team compartment."
  type        = string
  default     = null
  nullable    = true
}

variable "existing_compartment_id" {
  description = "Approved existing team compartment ID when creation is disabled."
  type        = string
  default     = null
  nullable    = true
}

variable "existing_compartment_name" {
  description = "Approved existing team compartment name when creation is disabled."
  type        = string
  default     = null
  nullable    = true
}

variable "object_storage_namespace" {
  description = "Object Storage namespace; required only when Object Storage is explicitly enabled."
  type        = string
  default     = ""
}

variable "enable_object_storage" {
  description = "Create the team Object Storage bucket. Disabled until a lab requires it."
  type        = bool
  default     = false
}

variable "enable_autonomous_database" {
  description = "Create the team Autonomous Database. This consumes trial credits and requires explicit approval."
  type        = bool
  default     = false
}

variable "autonomous_admin_password" {
  description = "ADB administrator password provided only as TF_VAR_autonomous_admin_password."
  type        = string
  sensitive   = true
  default     = null
  nullable    = true
}

variable "autonomous_compute_count" {
  description = "Autonomous Database ECPU count for the team lab."
  type        = number
  default     = 2

  validation {
    condition     = var.autonomous_compute_count >= 2
    error_message = "autonomous_compute_count must be at least two ECPUs."
  }
}

variable "autonomous_storage_tbs" {
  description = "Autonomous Database storage in TB."
  type        = number
  default     = 1
}

variable "autonomous_db_version" {
  description = "Database version required for Oracle AI Agent Memory."
  type        = string
  default     = "26ai"
}

variable "autonomous_auto_scaling_enabled" {
  description = "Enable ADB auto scaling only after the trial-credit review."
  type        = bool
  default     = false
}

variable "autonomous_mtls_required" {
  description = "Require mTLS wallet connectivity for participant application users."
  type        = bool
  default     = true
}

variable "autonomous_license_model" {
  description = "ADB license model."
  type        = string
  default     = "LICENSE_INCLUDED"
}

variable "enable_iam_policies" {
  description = "Create optional OCI IAM policies. Disabled for the team trial baseline."
  type        = bool
  default     = false
}

variable "participant_group_name" {
  description = "OCI group only if separately approved for this team trial."
  type        = string
  default     = "khipu-workshop-participants"
}

variable "facilitator_group_name" {
  description = "OCI group only if separately approved for this team trial."
  type        = string
  default     = "khipu-workshop-facilitators"
}

variable "freeform_tags" {
  description = "Required ownership and cost tags, excluding values already generated by this profile."
  type        = map(string)
  default     = {}
}
