# OCI configuration. Never commit a populated .env file.
OCI_REGION=<tenant_home_region>
OCI_COMPARTMENT_ID=<approved_workshop_compartment_ocid>
OCI_CONFIG_PROFILE=<participant_oci_profile>
OCI_CONFIG_FILE=<optional_private_oci_config_path>

# Select this only after the tenant preflight.
LAB01_CHAT_MODEL_ID=<approved_on_demand_chat_model_id>
LAB01_MAX_OUTPUT_TOKENS=120

# All database values belong in a private participant session file, not in this file.
LAB01_WALLET_DIR=<absolute_private_wallet_directory>
LAB01_DB_USER=<temporary_application_database_user>
LAB01_DB_DSN=<wallet_service_name>
LAB01_MEMORY_SCHEMA_OWNER=<memory_owner_schema>
LAB01_MEMORY_STORE_ID=<precreated_memory_store_id>
