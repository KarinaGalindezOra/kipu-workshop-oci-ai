# OCI configuration. Never commit a populated .env file.
OCI_REGION=us-chicago-1
OCI_COMPARTMENT_ID=<workshop_compartment_ocid>
OCI_CONFIG_PROFILE=DEFAULT
# Optional only when OCI config is not in the default local location.
OCI_CONFIG_FILE=<optional_oci_config_file_path>

# Select actual model IDs only after the Chicago model-discovery preflight.
OCI_CHAT_MODEL_ID=<approved_chat_model_id>
OCI_EMBEDDING_MODEL_ID=<approved_embedding_model_id>

# Workshop isolation. Use a unique value for every team.
WORKSHOP_TEAM_ID=team-01
WORKSHOP_AGENT_ID=khipu-workshop-agent

# Autonomous Database connection. Store real credentials in OCI Vault or a secure local secret store.
ADB_CONNECT_STRING=<adb_connect_string>
ADB_USERNAME=<team_database_user>
ADB_WALLET_DIR=<path_to_unpacked_wallet>

# Lab 1 live integration. Keep the identifier short, stable, and workshop-specific.
LAB01_MEMORY_STORE_ID=khipu_lab01
# Select this on-demand Cohere-compatible chat model only after the tenant preflight.
# The participant runner makes two paid calls only with --confirm-live-inference.
LAB01_CHAT_MODEL_ID=<approved_lab01_chat_model_id>
LAB01_MAX_OUTPUT_TOKENS=120

# Local Lab 1 gateway rehearsal only. Configure this only on the facilitator's
# machine through an approved secret mechanism; never distribute the signing secret.
LAB01_WORKSHOP_TOKEN_SECRET=<facilitator_only_local_secret>

# Lab 2 RAG configuration. The live integration is enabled only after its OCI preflight.
# The live runner uses only the repository's synthetic corpus. It inserts missing
# chunks only after --confirm-synthetic-load and never updates or deletes rows.
LAB02_VECTOR_DIMENSION=<approved_embedding_dimension>
LAB02_TOP_K=3
LAB02_CONTRACT_TABLE=LAB02_CONTRACT_CHUNKS

# Lab 2: use its config/oci.env.example for the Chicago participant target.
LAB02_CALIBRATION_FILE=<private_calibration_json>
LAB02_SET_OUTPUT_DIMENSIONS=false

# Lab 2 only: individual session mapping. Must match ADB_USERNAME=KHIPU_L2_Pnnn.
LAB02_PARTICIPANT_ID=<assigned_participant_id>
